# Local generated env files (legacy root + runtime dirs)
phase*_env.sh
phase*_env.sh.bak.*

# Runtime env files
runtime/env/latest/
runtime/env/backups/

# Runtime evidence
evidencias/runs/

# Downloaded data generated by local runs
downloads/assets/
downloads/manifests/
!downloads/assets/.gitkeep
!downloads/manifests/.gitkeep

# Generated HTTP/curl responses
data/real/consumo/responses/
data/real/ingesta/responses/*
!data/real/ingesta/responses/.gitkeep
!data/real/ingesta/responses/pre/
data/real/ingesta/responses/pre/*
!data/real/ingesta/responses/pre/.gitkeep
!data/real/ingesta/responses/pro/
data/real/ingesta/responses/pro/*
!data/real/ingesta/responses/pro/.gitkeep

# Optional local real input data
data/real/ingesta/*.csv
data/real/ingesta/*.xlsx
data/real/ingesta/*.zip

# Sensitive runtime artifacts
*.sensitive.json
*.secret.json
*.pem
*.key
*token*
*secret*
data/real/ingesta/auth/*.env
!data/real/ingesta/auth/*.env.example

# Local flow credentials
flujos/*/user_provider.sh
flujos/*/user_consumer.sh
flujos/**/user_provider.sh
flujos/**/user_consumer.sh
!flujos/**/user_provider.example.sh
!flujos/**/user_consumer.example.sh

# Local/system
.DS_Store
.env
.env.*
.cursor/

# Generated evidence delivery reports
reports/

# Python bytecode
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Logs that may include tokens or credentials
*.log
logs/
