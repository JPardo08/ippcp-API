#!/usr/bin/env bash
# Copiar como ingesta_api_key_prod.env y completar solo en local.
# El fichero real está ignorado por Git (data/real/ingesta/auth/*.env).
#
# Separado de ingesta_api_key.env (PRE validado) para que PRE y PROD
# puedan divergir sin tocar código ni el flujo PRE.
#
# Para assets PROD POST con provider_id embebido en ASSET_CONFIG,
# INGESTA_API_PROVIDER_ID no es necesario en phase1.

export INGESTA_API_KEY="REPLACE_ME"
